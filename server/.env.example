# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/pulse_studio?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="super-secret-jwt-access-key-change-in-production-min32chars"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh Token Secret & Settings
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production-min32chars"
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie Secret
COOKIE_SECRET="super-secret-cookie-signing-key-change-in-production"
