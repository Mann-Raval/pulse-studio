# Production / Custom Environment Variables for Vite
# (In local dev, leave blank or omit to use Vite proxy at http://localhost:5000)

# Backend REST API base URL (e.g. https://api.yourdomain.com/api or /api)
# VITE_API_URL=https://api.yourdomain.com/api

# Backend Socket.io server URL (e.g. https://api.yourdomain.com)
# VITE_SOCKET_URL=https://api.yourdomain.com
